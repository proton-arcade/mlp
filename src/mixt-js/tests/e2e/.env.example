# Copy this file to `.env` (in the same folder) and fill in your local values.
# `.env` is gitignored — never commit real credentials.

# Required: admin password from your local Mixt.
# It is the "password" value in admin/admin.json at the repo root, which
# `node server.cjs` creates on first start. Copy it here.
MIXT_ADMIN_PASSWORD=

# Optional overrides (defaults shown).
# MIXT_ADMIN_USERNAME=admin
# MIXT_TEST_ORIGIN=http://localhost:4100
# MIXT_TEST_FIXTURE_ORIGIN=http://localhost:8080
